  "system": {
    "description": {
      "value": "<p><strong>Benefits:</strong> When crafting a magic item or paying for the material components of a spell or ritual, you may gain points of Accrual to reduce the cost of these effects. Each point of Accrual you gain reduces the cost by 400 gp per character level you possess (to a minimum of 0 gp). In addition, when making an opposed check to render a service from a trapped outsider (such as one within the planar binding spell), you may suffer a point of Accrual to gain a +5 bonus to the check.</p>\n<hr>\n<p><a href=\"http://spheresofpower.wikidot.com/accrual#toc15\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
