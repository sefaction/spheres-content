  "system": {
    "description": {
      "value": "<p>Your blood contains powerful healing properties.</p>\n<p><strong>Prerequisite:</strong> Life’s Blood<sup>ARG</sup></p>\n<p><strong>Benefit:</strong> When you use this feat, the creature healed by the ritual gains hit points equal to twice the damage you take.</p>\n<p>Additionally, you can spend a use of mythic power to add lingering effects to the ritual. The affected creature gains fast healing 1 for a number of rounds equal to the number of points of damage you take.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-general-g-m-feats#toc68\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
