  "system": {
    "description": {
      "value": "<p>You despise the strange and alien among you.</p>\n<p><strong>Prerequisite:</strong> Xenophobia<sup>GCC</sup></p>\n<p><strong>Benefit:</strong> The bonuses granted by this feat are doubled. In addition, your hatred for alien things seeps into your comrades. Allies within 10 feet of you gains a +1 bonus on Intimidate, Knowledge, and Survival checks and a +1 morale bonus on attack rolls against aberrations and creatures with the mythos subtype. They also take a -1 penalty on saves against fear effects used by such creatures.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-mythos-feats#toc6\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
