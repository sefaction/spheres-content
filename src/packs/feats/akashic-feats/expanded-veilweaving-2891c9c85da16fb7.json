  "system": {
    "description": {
      "value": "<p>You can shape more veils at once.</p>\n<p><strong>Prerequisite:</strong> Shape Veil and no levels in a veilweaving class, or veilweaver level 11.</p>\n<p><strong>Benefit:</strong> Increase your maximum veils shaped by 1.</p>\n<p><strong>Special:</strong> Characters who take this feat that do not have levels in a veilweaving class may take it multiple times, but no more than once per 5 Hit Dice they possess. If a character who has taken this feat multiple times later gains levels in a veilweaving class, they must immediately retrain all instances of this feat other than the first to another feat they qualify for.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/akashic-feats#toc30\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
