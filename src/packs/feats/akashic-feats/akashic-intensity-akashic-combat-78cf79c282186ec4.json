  "system": {
    "description": {
      "value": "<p><strong>Prerequisites:</strong> tension pool</p>\n<p><strong>Benefits:</strong> As a swift action, you may spend any amount of tension to gain temporary essence equal to half the amount of tension spent. This temporary essence lasts for 1 round and may be invested as part of the action to generate it.</p>\n<p><sup><strong>Source:</strong> Baron’s Glorious Arena</sup></p>\n<p><a href=\"http://spheresofpower.wikidot.com/akashic-feats#toc9\">Source: Spheres of Power Wiki</a></p>",
