  "system": {
    "description": {
      "value": "<p>You dwell in darkness, treating it as your home.</p>\n<p><strong>Prerequisites:</strong> Darkness spell or spell-like ability, character level 7th.</p>\n<p><strong>Benefit:</strong> You are permanently affected by the protective penumbra spell with a caster level equal to your Hit Dice. You may choose to dismiss or regain this effect as a free action once per round.</p>\n<p><strong>Special:</strong> Undead with 7 or more hit dice can take this feat, ignoring its prerequisites.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/judow#toc37\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
