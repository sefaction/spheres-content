  "system": {
    "description": {
      "value": "<p><strong>Prerequisite:</strong> 3 ranks in any 1 skill.</p>\n<p><strong>Benefit:</strong> Choose a skill that you have at least 3 ranks in. When you perform an incantation which involves attempting a check with that skill, you do not suffer the effects of backlash if the incantation succeeds.</p>\n<p><strong>Special:</strong> This feat may be selected multiple times, each time applying to a different skill.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/general-feats#toc13\">Source: Spheres of Power Wiki</a></p>",
