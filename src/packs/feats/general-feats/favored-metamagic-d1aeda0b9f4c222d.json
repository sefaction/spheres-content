  "system": {
    "description": {
      "value": "<p><strong>Prerequisite:</strong> Any metamagic feat.</p>\n<p><strong>Benefit:</strong> Choose one metamagic feat that you possess. When you apply that metamagic feat to an effect you create, you do not increase the casting time for the effect (you must still expend spell points as normal).</p>\n<p><strong>Special:</strong> You may select this feat multiple times, each time selecting a different metamagic feat.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/general-feats#toc28\">Source: Spheres of Power Wiki</a></p>",
