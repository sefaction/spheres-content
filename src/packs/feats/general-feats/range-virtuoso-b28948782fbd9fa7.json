  "system": {
    "description": {
      "value": "<p><strong>Prerequisites:</strong> Sphere Virtuoso, must have taken at least one range talent at least twice.<br>\n<strong>Benefits:</strong> You count as possessing a number of all range talents equal to the number of instances you have selected a single range talent<br>\nExample: A character who has taken Ranged Enhancement three times and has the ability to create a ward can center that ward anywhere within long range, as if they had taken the Distant Protection talent three times.</p>\n<p><sup><strong>Source:</strong> Baron’s Glorious Arena</sup></p>\n<p><a href=\"http://spheresofpower.wikidot.com/general-feats#toc54\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
