  "system": {
    "description": {
      "value": "<p><strong>Prerequisites:</strong> Ravenous Companion, caster level 10th.</p>\n<p><strong>Benefit:</strong> When your companion is grappling a creature, it may attempt to use its swallow whole ability as a free action. It gains a +2 competence bonus to CMB and CMD to make and resist grapple checks relating to the swallow whole ability.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/companion-feats#toc3\">Source: Spheres of Power Wiki</a></p>",
