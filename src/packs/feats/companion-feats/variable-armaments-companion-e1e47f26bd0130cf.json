  "system": {
    "description": {
      "value": "<p><strong>Prerequisites:</strong> Conjuration sphere (Battle Creature (form) or Shield Bearer (form)), companion with 6 or more Hit Dice.</p>\n<p><strong>Benefit:</strong> A companion that possesses Battle Creature or Shield Bearer may substitute the enhancement bonus to its weapons and shields granted by those talents for weapon and shield special abilities available per the armorist bound equipment table. The weapon or shield must maintain at least a +1 enhancement bonus. Changing the selected special abilities requires an 8 hour ritual.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/companion-feats#toc6\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
