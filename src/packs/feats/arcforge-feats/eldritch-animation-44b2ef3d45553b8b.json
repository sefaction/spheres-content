  "system": {
    "description": {
      "value": "<p>Your undead creatures are fortified against magic.</p>\n<p><strong>Prerequisites:</strong> ability to create undead creatures</p>\n<p><strong>Benefit:</strong> Any undead creatures created by you gain spell resistance equal to 5 + your caster level. Creatures which would possess a higher spell resistance normally are unaffected by this. In addition, undead creatures you create gain channel resistance +4 or increases its existing channel resistance by +2 (whichever provides a higher bonus) against all effects from a source other than you.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/arcforge-feats#toc11\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
