  "system": {
    "description": {
      "value": "<p>You and your allies work together to keep your enemies down.</p>\n<p><strong>Prerequisites:</strong> Tandem Trip<sup>UC</sup></p>\n<p><strong>Benefit:</strong> Whenever you would benefit from Tandem Trip you add one-half your mythic tier (minimum 1) to your combat maneuver check to trip an opponent. If a tripped creature provokes an attack of opportunity from you before the end of your next turn, you also add this bonus on your damage roll if your attack of opportunity hits.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-teamwork-feats#toc29\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
