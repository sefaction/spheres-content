  "system": {
    "description": {
      "value": "<p>There is eldritch power in numbers.</p>\n<p><strong>Prerequisites:</strong> Allied Spellcaster<sup>APG</sup></p>\n<p><strong>Benefit:</strong> Whenever you are adjacent to an ally who also has this feat, you receive a +2 competence bonus to your caster level for all level-dependent variables, such as duration, range, and effect. If your ally has the same spell prepared (or known with a slot available if they are spontaneous spellcasters), this bonus increases to +4, and if you expend one point of mythic power you may cast the mythic version of the spell (if any).</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-teamwork-feats#toc0\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
