  "system": {
    "description": {
      "value": "<p><sup><strong>Source:</strong> Baron’s Glorious Arena</sup></p>\n<p><strong>Prerequisites:</strong> Divination Sphere, War Sphere (any momentum talent)</p>\n<p><strong>Benefits:</strong> Whenever an ally moves through the area of effect of a sphere effect you have successfully identified, they may spend a number of momentum points equal to 1 + the number of spell points spent on the sphere effect. If they do, you may attempt an MSB check against the sphere effect’s MSD, with the moving creature ignoring the sphere effect until the end of their movement on a success.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/divination#toc107\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
