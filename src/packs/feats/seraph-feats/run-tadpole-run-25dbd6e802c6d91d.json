  "system": {
    "description": {
      "value": "<p>When pursuing an enemy, your team openly mocks and intimidates them.</p>\n<p><strong>Prerequisites:</strong> Charisma 13.</p>\n<p><strong>Benefit:</strong> When you and at least one ally pursue the same enemy, you gain a +1 cumulative insight bonus to Intimidate skill checks against your target for each ally in your group actively pursuing the target (maximum +5).</p>\n<p><strong>Special:</strong> At least one of your pursuing allies must also possess this feat.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/seraph-feats#toc33\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
