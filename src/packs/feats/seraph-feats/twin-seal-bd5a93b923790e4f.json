  "system": {
    "description": {
      "value": "<p>You have learned to combine the power of your seals into greater seals of synergized power.</p>\n<p><strong>Prequisites:</strong> Spellseal class ability, tomeseal level 9th or higher.</p>\n<p><strong>Benefit:</strong> Select one school of magic you can create spellseals of. You may stack two seals of the same bonus type together. You may only have one set of seals stacked in this manner per instance of this feat.</p>\n<p><strong>Special:</strong> You may select this as a bonus feat with your bonus feat class feature. You may select this feat more than once but no more than twice at 13th level and a third time at 19th level.</p>\n<hr>\n<p><a href=\"http://spheresofpower.wikidot.com/seraph-feats#toc73\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
