  "system": {
    "description": {
      "value": "<p><strong>Prerequisites:</strong> Member of the Ashlords, Cleansing Fury, Favored enemy class feature or Creature Focus.</p>\n<p><strong>Benefit:</strong> You may transform spells you cast into divine cleansing energy. When resolving a fury spell against a creature that would be subject to your favored enemy or Creature Focus, you may remove energy descriptors from the spell and instead deal untyped divine or primal damage to them. The spell deals half its normal damage against creatures who are not subjects of a favored enemy or Creature Focus. A fury spell takes a spell slot one level higher than normal to prepare or cast.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/seraph-feats#toc70\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
