  "system": {
    "description": {
      "value": "<p>Your allies adopt your fearlessness in the face of peril.</p>\n<p><strong>Prerequisite:</strong> Fearless Aura<sup>UM</sup></p>\n<p><strong>Benefit:</strong> Your aura of courage expands to a 30-foot-radius emanation, and you and your allies gain immunity to all harmful non-mythic emotion effects whose spell level is lower than your tier. If you use your lay on hands ability to heal an ally, in place of a mercy you can grant that ally an aura of courage for a number of rounds equal to your Charisma modifier plus your mythic tier.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-general-a-f-feats#toc140\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
