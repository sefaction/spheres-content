  "system": {
    "description": {
      "value": "<p>The deafening effect of your bombs is persistent.</p>\n<p><strong>Prerequisite:</strong> Deafening Explosion<sup>ARG</sup></p>\n<p><strong>Benefit:</strong> A creature that takes a direct hit from your bomb is deafened for 1 minute plus 1 minute per mythic tier you possess. Any creatures caught taking splash damage is also deafened for 1 round per mythic tier you possess if it fails its save against the bomb’s splash.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-general-a-f-feats#toc80\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
