  "system": {
    "description": {
      "value": "<p>You nimbly slip aside from dangerous advances.</p>\n<p><strong>Prerequisite:</strong> Feline Grace<sup>ARG</sup></p>\n<p><strong>Benefit:</strong> Your CMD bonus against bull rush, grapple, overrun, reposition, and trip combat maneuvers increases to +4, and you can spend a use of mythic power as an immediate action to force an attacker to reroll their combat maneuver check when attempting one of these maneuvers against you; they must use the result of the second roll.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-general-a-f-feats#toc142\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
