  "system": {
    "description": {
      "value": "<p>You are adept at spreading the least of your portents far and wide.</p>\n<p><strong>Prerequisite:</strong> Student of the Loom, cartomancy class feature, maximum hand size 3 or higher,Wis 13</p>\n<p><strong>Benefit:</strong> Whenever you cast a least portent that targets a single creature, you may spend 1 fate point to have that portent affect a second creature within 10 feet of the primary target. Both creatures must be legal targets for the portent.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/cartomancy-feats#toc35\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
