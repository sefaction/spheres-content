  "system": {
    "description": {
      "value": "<p>You are capable of eliminating the negative effects of fate upon yourself.</p>\n<p><strong>Prerequisite:</strong> Lucky Dealer, maximum hand size 4 or larger</p>\n<p><strong>Benefit:</strong> Penalties imposed upon you by rolls on</p>\n<p><strong>Table:</strong> Tell Fortune Outcomes are insight bonuses instead. They are still treated as penalties for the purpose of duration reduction by the Lucky Dealer feat and are spread as penalties by the Fate by Association feat.</p>\n<p><strong>Normal:</strong> Penalties imposed upon you by rolls on Table: Tell Fortune Outcomes are penalties.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/cartomancy-feats#toc12\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
