  "system": {
    "description": {
      "value": "<p>Your magical protections shield your equipment from tampering</p>\n<p><strong>Prerequisites:</strong> Fate Sphere, Technomancy Sphere, hallow word</p>\n<p><strong>Benefit:</strong> Targets affected by your hallow word cannot have sprites enter them so long as the sprite originates from a creature who possesses your opposed alignment. If the target is already under the influence of such an effect, the target is allowed to make a Will saving throw against the sprite. Success means the sprite cannot use any programs for the duration of this word, but resumes when this word expires.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/technomancy\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
