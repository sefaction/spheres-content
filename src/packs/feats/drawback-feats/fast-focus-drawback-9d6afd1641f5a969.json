  "system": {
    "description": {
      "value": "<p><sup><strong>Source:</strong> <a href=\"https://www.drivethrurpg.com/product/286903/Spheres-Apocrypha-Casting-Traditions-2?affiliate_id=549120\">Spheres Apocrypha: Casting Traditions 2</a></sup></p>\n<p><strong>Prerequisites:</strong> Mental Focus.</p>\n<p><strong>Benefits:</strong> You can take a move action to regain mental focus.</p>\n<p><strong>Normal:</strong> A character without this feat must take a full-round action to regain mental focus.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/drawback-feats#toc23\">Source: Spheres of Power Wiki</a></p>",
