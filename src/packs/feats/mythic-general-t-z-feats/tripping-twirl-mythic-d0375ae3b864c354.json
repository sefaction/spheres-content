  "system": {
    "description": {
      "value": "<p>You knock your foes down like ninepins with a sweeping blows of your staff.</p>\n<p><strong>Prerequisite:</strong> Tripping Twirl<sup>UM</sup></p>\n<p><strong>Benefit:</strong> When using this feat, you add an amount equal to one-half your mythic tier on your combat maneuver checks to trip your opponents.</p>\n<p><strong>Special:</strong> If you are a magus and successfully trip a creature with your quarterstaff, if you then use your spellstrike ability against that target in the same round you gain a +4 bonus on caster level checks to overcome the target’s spell resistance.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-general-t-z-feats#toc15\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
