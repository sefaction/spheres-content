  "system": {
    "description": {
      "value": "<p><strong>Prerequisites:</strong> Fallen Fey sphere (Beckoning Call (fey-blessing) or Enchanting Music (fey-blessing)); bardic performance or raging song class feature.</p>\n<p><strong>Benefit:</strong> You may use your Beckoning Call or any of your Enchanting Music options in place of a bardic performance or raging song, starting and maintaining the effects as if it was a performance or raging song by spending performance or raging song rounds. Feats such as Lingering Performance apply to your Beckoning Call and Enchanting Music when used in this way.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/fallen-fey#toc67\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
