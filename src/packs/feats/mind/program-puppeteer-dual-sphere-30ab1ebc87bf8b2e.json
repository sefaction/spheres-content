  "system": {
    "description": {
      "value": "<p><sup><strong>Source:</strong> Arcforge Players Compendium</sup></p>\n<p><strong>Prerequisites:</strong> Mind sphere, Technomancy sphere.</p>\n<p><strong>Benefit:</strong> You may treat any construct which is acting as a host of one of your sprites and any AI installed in your sprite’s host as having a living mind for the purpose of being able to affect it with your Mind sphere abilities, ignoring their immunity to mind-affecting effects. In addition, you may create sprites in and move sprites into any creatures which can be affected by your charms. Such creatures may be affected by your sprites as if they were constructs.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mind#toc93\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
