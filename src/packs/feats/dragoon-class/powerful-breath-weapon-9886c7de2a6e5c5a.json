  "system": {
    "description": {
      "value": "<p>Drawing on your heritage, you can empower your breath weapon.</p>\n<p><strong>Prerequisites:</strong> Draconic breath weapon racial trait, character level 5th.</p>\n<p><strong>Benefit:</strong> The damage your breath weapon deals increases to d8s. At 10th level, it instead deals d10s, and at 15th level it deals d12s.</p>\n<hr>\n<p><a href=\"http://spheresofpower.wikidot.com/dragoon-class#toc33\">Source: Spheres of Power Wiki</a></p>",
