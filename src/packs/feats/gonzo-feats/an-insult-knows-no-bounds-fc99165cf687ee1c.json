  "system": {
    "description": {
      "value": "<p>Warning: This character contains strong language that may be unsuitable for anybody.</p>\n<p><strong>Prerequisites:</strong> Strong Language, Linguistics 12 ranks.</p>\n<p><strong>Benefit:</strong> Your magical insults can effect creatures who cannot normally be effected by your insults. This includes things like deaf creatures, mindless creatures, etc. A creature must still be able to be affected by the resulting condition or effect imposed on them by the insult.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/gonzo-feats#toc19\">Source: Spheres of Power Wiki</a></p>",
