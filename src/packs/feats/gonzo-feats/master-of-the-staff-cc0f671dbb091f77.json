  "system": {
    "description": {
      "value": "<p>You have whipped your servants into shape - they are the best in the business.</p>\n<p><strong>Prerequisites:</strong> Unseen servant class feature or ability to cast 3rd level arcane spells.</p>\n<p><strong>Benefit:</strong> Unseen servants, whether conjured by the spell or the battle butler class feature, have improved statistics. They have a Strength score of 6 (about 60 pounds of lift, 300 lbs dragging), its base speed is 30 feet, and they can take 20 points of damage before they disappear.</p>\n<p><strong>Note:</strong> This is not a metamagic feat and does not modify the level of the spell.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/gonzo-feats#toc36\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
