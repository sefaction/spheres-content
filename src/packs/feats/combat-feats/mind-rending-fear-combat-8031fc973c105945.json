  "system": {
    "description": {
      "value": "<p><sup><strong>Source:</strong> Arcforge Players Compendium</sup></p>\n<p><strong>Prerequisite:</strong> Intimidate 9 ranks.</p>\n<p><strong>Benefit:</strong> Whenever you cause a creature to become shaken, frightened, or subjected to any<br>\nother level of fear, you deal 1d4 points of Wisdom damage to that creature. If you are using the strain system, you may instead deal twice as much strain damage as you would Wisdom damage. A successful Will save (DC 10 + 1/2 your ranks in Intimidate + your Charisma modifier) negates this effect.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/combat-feats#toc45\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
