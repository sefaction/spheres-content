  "system": {
    "description": {
      "value": "<p>Your bullets can knock your ally’s shots back on course.</p>\n<p><strong>Prerequisite:</strong> Redirected Shot<sup>ISC</sup></p>\n<p><strong>Benefit:</strong> You can use this feat after the result of an ally’s ranged attack has been revealed. In addition, if your ally uses a ranged attack against a creature that has cover from its position but has no cover or less cover from your position, use the lower cover bonus to AC when resolving the ranged attack.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-combat-n-z-feats#toc48\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
