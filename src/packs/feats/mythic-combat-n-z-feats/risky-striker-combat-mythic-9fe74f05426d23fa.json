  "system": {
    "description": {
      "value": "<p>You dive dangerously into combat in order to strike telling blows.</p>\n<p><strong>Prerequisite:</strong> Risky Striker<sup>ARG</sup></p>\n<p><strong>Benefit:</strong> When you use this feat, you gain a +3 bonus on melee damage rolls instead of +2. When your base attack bonus reaches +4 and every 4 points thereafter, the amount of bonus damage increases by +3 instead of +2. You can expend one use of mythic power to negate the AC penalty for using this feat for a number of rounds equal to your mythic tier.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-combat-n-z-feats#toc53\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
