  "system": {
    "description": {
      "value": "<p>Your expertise in this weapon allows you to disarm and trip opponents more easily.</p>\n<p><strong>Prerequisite:</strong> Whip Mastery<sup>UC</sup></p>\n<p><strong>Benefit:</strong> You gain a +2 bonus on combat maneuver checks to disarm or trip an opponent with your whip. You can expend one use of mythic power to take an attack with your whip at your highest attack bonus against any target you have just successfully disarmed or tripped with your whip.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-combat-n-z-feats#toc146\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
