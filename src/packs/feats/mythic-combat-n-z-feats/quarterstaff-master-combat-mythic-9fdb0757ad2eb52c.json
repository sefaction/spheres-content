  "system": {
    "description": {
      "value": "<p>Your staff is a conduit for your mythic power.</p>\n<p><strong>Prerequisite:</strong> Quarterstaff Master<sup>UM</sup></p>\n<p><strong>Benefit:</strong> When wielding your quarterstaff as a one-handed weapon you may add 1-1/2 times your Strength bonus on attacks. In addition you may expend one use of your mythic power as a move action to grant any quarterstaff you wield an enhancement bonus equal to one-half your mythic tier (minimum 1) for 1 minute per mythic tier. This bonus stacks with any existing enhancement bonus the quarterstaff already has, up to a maximum of +5. You may apply the bonus granted through this feat to only one end of the quarterstaff, or divide it between both ends as you wish.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-combat-n-z-feats#toc37\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
