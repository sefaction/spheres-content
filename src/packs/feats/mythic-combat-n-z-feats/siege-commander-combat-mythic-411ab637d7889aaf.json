  "system": {
    "description": {
      "value": "<p>Under your leadership your allies are masters of siege combat.</p>\n<p><strong>Prerequisites:</strong> Siege Commander<sup>UC</sup></p>\n<p><strong>Benefit:</strong> When you lead a siege engine assembly crew the time required to assemble a siege engine is reduced to 1/4th. Additionally, any creature who can see and hear you is treated as if they had a number of non-mythic siege engine or ranged weapon related feats you possess (up to a maximum number of feats equal to your mythic tier). These feats may only be used in conjunction with a siege engine.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-combat-n-z-feats#toc78\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
