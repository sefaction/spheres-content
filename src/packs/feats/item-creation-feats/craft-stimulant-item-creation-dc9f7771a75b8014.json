  "system": {
    "description": {
      "value": "<p><sup><strong>Source:</strong> Arcforge Players Compendium</sup></p>\n<p><strong>Prerequisite:</strong> Caster or manifester level 5th.</p>\n<p><strong>Benefit:</strong> You can create <a href=\"http://spheresofpower.wikidot.com/stimulants\">stimulants</a>. Crafting a stimulant takes 1 day for each 1,000 gp in its base price. To craft a stimulant, you must use up raw materials costing half of its base price.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/item-creation-feats#toc9\">Source: Spheres of Power Wiki</a></p>",
