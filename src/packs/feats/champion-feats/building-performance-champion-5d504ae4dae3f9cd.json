  "system": {
    "description": {
      "value": "<p><strong>Prerequisites:</strong> Performance sphere, tension pool</p>\n<p><strong>Benefits:</strong> Whenever you spend a standard or move action to begin an act, perform a scene, apply an (instrumental) talent, or grant a lyric effect, you gain 1 point of tension.</p>\n<p>Whenever you gain tension through maneuver momentum while benefiting from a (dance) talent, you gain one additional point of tension.</p>\n<p>You may spend 2 points of tension to reduce one of the above listed actions from a standard action to a move action or from a move action to a swift action.</p>\n<p><sup><strong>Source:</strong> Baron’s Glorious Arena</sup></p>\n<p><a href=\"http://spheresofpower.wikidot.com/champion-feats#toc20\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
