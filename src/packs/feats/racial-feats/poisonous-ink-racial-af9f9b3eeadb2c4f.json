  "system": {
    "description": {
      "value": "<p>The ink you produce in quantity can do more than blind opponents, sometimes sickening or even killing foes.</p>\n<p><strong>Prerequisites:</strong> Cecaelia subtype, Improved Ink Jet.</p>\n<p><strong>Benefit:</strong> In addition to causing blindness for 1 minute, your ink jet becomes poisonous.</p>\n<p><strong>Ink jet</strong>—contact; <strong>save</strong> Fort DC 10 + 1/2 cecaelia’s hit dice + cecaelia’s Constitution modifier; <strong>frequency</strong> 1/round for 6 rounds; <strong>effect</strong> 1d2 Con, <strong>cure</strong> 2 saves.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/racial-feats#toc29\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
