  "system": {
    "description": {
      "value": "<p><strong>Benefit:</strong> Choose a single type of magic. You gain a +2 competence bonus to all saving throws against magical effects of that type.</p>\n<p><strong>Special:</strong> You may select this feat multiple times, each time applying it to a different type of magic. This feat counts as Divine Defiance for all purposes.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/variant-rules#toc32\">Source: Spheres of Power Wiki</a></p>",
