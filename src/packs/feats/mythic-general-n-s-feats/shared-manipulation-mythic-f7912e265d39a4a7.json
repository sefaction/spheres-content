  "system": {
    "description": {
      "value": "<p>Your powers of persuasion assist your allies in fooling or frightening foes.</p>\n<p><strong>Prerequisite:</strong> Shared Manipulation<sup>ARG</sup></p>\n<p><strong>Benefit:</strong> You can use this feat as a swift action. If you expend one use of mythic power as a move action, the bonus is increased to +3 and applies to both Bluff and Intimidate checks made by your allies for a number of rounds equal to your Charisma modifier plus your mythic tier.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-general-n-s-feats#toc56\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
