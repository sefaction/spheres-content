  "system": {
    "description": {
      "value": "<p>You are a favored disciple of the albino god of pain who rules the dark and shadowed woodlands.</p>\n<p><strong>Prerequisite:</strong> Shade of the Woodlands<sup>ISWG</sup></p>\n<p><strong>Benefit:</strong> You can expend mythic power to cast the mythic versions of any of the spells granted by this feat whose spell level is lower than your mythic tier. In addition, you add your mythic tier to the hardness of your mystic token, and you add twice your mythic tier to its hit points.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-general-n-s-feats#toc44\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
