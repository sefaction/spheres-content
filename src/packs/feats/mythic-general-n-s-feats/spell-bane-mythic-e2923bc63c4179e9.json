  "system": {
    "description": {
      "value": "<p>Creatures affected by your bane weapon find your spells nearly impossible to resist.</p>\n<p><strong>Prerequisites:</strong> Spell Bane<sup>UC</sup></p>\n<p><strong>Benefit:</strong> While your bane class feature is affecting a creature type you can expend one use of mythic power as part of casting a spell from your chosen school to force any of the spell’s targets of that creature type to roll their saving throws twice, taking the lower result.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-general-n-s-feats#toc70\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
