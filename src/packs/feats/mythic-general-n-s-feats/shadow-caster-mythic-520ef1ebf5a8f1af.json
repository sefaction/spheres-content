  "system": {
    "description": {
      "value": "<p>Your spells draw upon the deepest wells of dark power.</p>\n<p><strong>Prerequisite:</strong> Shadow Caster<sup>ARG</sup></p>\n<p><strong>Benefit:</strong> You add one-half your mythic tier (minimum 1) to your caster level to determine the duration of spells you cast from the shadow subschool or with the darkness descriptor. You also add this to the DC to dispel such spells. If you expend one use of your mythic power, you add your full mythic tier or level. Darkness spells you cast are considered to be 2 levels higher for the purpose of determining whether they are countered or suppressed by magical light effects.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-general-n-s-feats#toc45\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
