  "system": {
    "description": {
      "value": "<p><strong>Prerequisite:</strong> Unseen forces class feature.</p>\n<p><strong>Benefit:</strong> You gain an additional unseen augmentation for which you qualify. You may take this feat multiple times. The effects stack.</p>\n<p><em>Wiki Note:</em> \"Extra Unseen Augmentation\" refers to the Unseen Forces class feature, which does not exist. This feat should either require the Lurking Forces class feature, allowing a thaumaturge to select this as early as 4th level, or the Unseen Augmentations class feature, allowing a thaumaturge to select this when they receive their first augmentation naturally. Either is a recommended option, subject to GM discretion.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/unseen-horror#toc11\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
