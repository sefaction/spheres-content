  "system": {
    "description": {
      "value": "<p>Your spells resound with your soul-force.</p>\n<p><strong>Prerequisite:</strong> Ki Infusion<sup>WK</sup></p>\n<p><strong>Benefit:</strong> As long as you have at least 1 point in your ki pool, your bonus on caster level checks increases to +2. You can use this feat to increase your caster level as a free action, and if you expend one use of your mythic power you increase the caster level of the spell or spell-like ability you use by 1 for every point you spend from your ki pool, up to a maximum equal to your Wisdom bonus.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-ki-feats#toc34\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
