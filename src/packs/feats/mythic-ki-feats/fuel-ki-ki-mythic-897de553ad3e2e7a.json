  "system": {
    "description": {
      "value": "<p>Your living body is fuel for your inner strength.</p>\n<p><strong>Prerequisite:</strong> Fuel Ki<sup>WK</sup></p>\n<p><strong>Benefit:</strong> You regain 3 ki points for every 2 points of Strength, Dexterity, or Constitution damage you take, and you can exceed your normal maximum daily ki points by an amount equal to your mythic tier, though ki points over your normal daily maximum not spend within a number of hours equal to your mythic tier are lost. Using this feat is a move action.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-ki-feats#toc22\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
