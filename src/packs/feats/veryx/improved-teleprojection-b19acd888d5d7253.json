  "system": {
    "description": {
      "value": "<p>Your telepathic abilities are more powerful and refined than those of other veryx.</p>\n<p><strong>Prerequisites:</strong> Charisma 13+ or Wisdom 13+, teleprojective language species feature.</p>\n<p><strong>Benefit:</strong> Your telepathic projections become more powerful and skilled. Your range on your telepathic projection doubles. Your telepathic “yell” is heard to close range (25 ft. + 5 ft./level). You may use a standard action to selectively communicate to a number of creatures equal or less that your choice of Charisma or Wisdom modifier. You may hear surface thoughts back from these creatures for 1 round if they are willing.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/veryx#toc33\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
