  "system": {
    "description": {
      "value": "<p><sup><strong>Source:</strong> Arcforge Players Compendium</sup></p>\n<p><strong>Prerequisites:</strong> Enhancement sphere, Circle Casting, Spell Proxy, casting class feature, collective class feature, magic skill bonus +10.</p>\n<p><strong>Benefit:</strong> The benefits of your Proxy feats apply to creatures within your collective regardless of range. This does not allow them to use the Circle Casting feat from beyond the normal range.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/antestes#toc15\">Source: Spheres of Power Wiki</a></p>",
