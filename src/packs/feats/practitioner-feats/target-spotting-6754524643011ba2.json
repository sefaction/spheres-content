  "system": {
    "description": {
      "value": "<p><strong>Prerequisites:</strong> Scout sphere, favored enemy class feature.</p>\n<p><strong>Benefit:</strong> Whenever you scout an enemy, you may expend your martial focus to treat them, for the duration of the scout, as your favored enemy for the purpose of your favored enemy ability. You receive the maximum bonuses against them that your favored enemy feature can grant.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/practitioner-feats#toc98\">Source: Spheres of Power Wiki</a></p>",
