  "system": {
    "description": {
      "value": "<p><strong>Prerequisite:</strong> Warp sphere.</p>\n<p><strong>Benefit:</strong> You allow a magic effect to function even without line of effect, transporting its effects through barriers that would otherwise impede it. You must still possess line of sight for effects that require it, and the target must still be within the effect’s range.</p>\n<p><strong>Cost:</strong> +3 spell points.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/metamagic-feats#toc6\">Source: Spheres of Power Wiki</a></p>",
