  "system": {
    "description": {
      "value": "<p><sup><strong>Source:</strong> Arcforge Players Compendium</sup></p>\n<p><strong>Prerequisites:</strong> Life sphere; Life sphere (Esoteric Healing) or Technomancy sphere.</p>\n<p><strong>Benefit:</strong> You may use any Life sphere ability which restores hit points to a creature on broken or damaged objects, restoring hit points to them as if they were creatures. If the object has the broken condition, this condition is removed if the object is restored to at least half its original hit points. This ability cannot restore warped or transmuted items, but it can still repair damage done to such items.</p>\n<p><strong>Special:</strong> This feat is only considered a dual sphere feat if you do not possess the Esoteric Healing talent.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/life#toc61\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
