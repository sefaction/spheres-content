  "system": {
    "description": {
      "value": "<p><sup><strong>Source:</strong> Baron’s Glorious Arena</sup></p>\n<p><strong>Prerequisites:</strong> Life Sphere (Affliction), Vampiric Disruption</p>\n<p><strong>Benefit:</strong> When you use Vampiric Disruption, you may spend an additional spell point to use the Life sphere ability as a free action rather than a swift action. In addition, you may target any creature within the range of your Life sphere talents with the effect rather than only yourself.</p>\n<p><em>Wiki Note:</em> This feat isn't intended to be used alongside additional instances of Affliction. Any additional Life sphere talents created using this feat cannot be used to inflict negative conditions or deal damage to targets.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/life#toc86\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
