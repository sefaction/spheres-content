  "system": {
    "description": {
      "value": "<p>You are exceptionally good at pact magic, even when dabbling into other professions.</p>\n<p><strong>Prerequisite:</strong> Bind spirit class feature.</p>\n<p><strong>Benefit:</strong> Increase your binder level by 4 for the purpose of determining the effects of your granted abilities. This feat cannot cause your binder level to exceed your character level and the increase in binder level granted by this feat doesn’t increase your maximum spirit level.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/pact-magic-feats#toc58\">Source: Spheres of Power Wiki</a></p>",
