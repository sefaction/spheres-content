  "system": {
    "description": {
      "value": "<p>You are able to use your occult powers with frightening speed.</p>\n<p><strong>Prerequisites:</strong> Cha 13; bind spirit class feature; base attack bonus +3, brawler’s strike class feature, or flurry of blows class feature.</p>\n<p><strong>Benefit:</strong> When you take a full attack action or use brawler’s flurry or flurry of blows, you may substitute an attack with a bound spirit’s major granted ability. This granted ability must have an activation time of 1 standard action or less. You must choose the attack with the highest base attack bonus to be substituted.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/pact-magic-feats#toc6\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
