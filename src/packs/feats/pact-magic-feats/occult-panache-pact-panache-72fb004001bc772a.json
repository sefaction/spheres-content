  "system": {
    "description": {
      "value": "<p>Your skill with occult powers fuels your flamboyant recklessness.</p>\n<p><strong>Prerequisites:</strong> Amateur Swashbuckler<sup>ACG</sup> or panache class feature; bind spirit class feature.</p>\n<p><strong>Benefit:</strong> Each time you confirm a critical hit with a granted ability (or a weapon created by a granted ability) or reduce a creature to 0 or fewer hit points with a granted ability, you regain 1 panache point. You do not regain panache in this manner if you meet one of these conditions by attacking an unattended object, a helpless or unaware creature, or a creature with fewer Hit Dice than half your character level.</p>\n<hr>\n<p><a href=\"http://spheresofpower.wikidot.com/pact-magic-feats#toc73\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
