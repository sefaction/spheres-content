  "system": {
    "description": {
      "value": "<p>You can exclude creatures from the effects of your occult powers.</p>\n<p><strong>Prerequisites:</strong> Bind spirit class feature, ability to bind 4th-level spirits.</p>\n<p><strong>Benefit:</strong> Whenever you activate a granted ability that affects an area, you may exclude a number of creatures from the granted ability’s effects equal to your Charisma modifier. These targets are not affected by your granted ability.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/pact-magic-feats#toc62\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
