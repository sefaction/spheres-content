  "system": {
    "description": {
      "value": "<p>The spirits boost your attacks to overcome damage reduction.</p>\n<p><strong>Prerequisites:</strong> Improved Unarmed Strike; Amateur Pactmaker† or bind spirit class feature.</p>\n<p><strong>Benefit:</strong> While bound to a spirit, your unarmed strikes are considered magic and silver weapons for the purpose of overcoming damage reduction. If you are a monk or a brawler, you are considered 4 levels higher when determining the benefits of your ki strike class feature or brawler’s strike class feature against your bound spirit’s favored enemies.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/pact-magic-feats#toc4\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
