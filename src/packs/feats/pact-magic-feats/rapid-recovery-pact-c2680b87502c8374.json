  "system": {
    "description": {
      "value": "<p>You quickly regain access to your major granted abilities.</p>\n<p><strong>Prerequisite:</strong> Bind spirit class feature.</p>\n<p><strong>Benefit:</strong> While bound to a spirit, reduce the number of rounds that your spirit’s major granted abilities are expended for after they are used by 1 round. This feat cannot reduce the number of grounds that a granted ability is expended for if it was expended to activate another feat or class feature (such as Furious Strike†).</p>\n<p><strong>Normal:</strong> A spirit’s major granted ability is expended for 5 rounds after it is used.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/pact-magic-feats#toc59\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
