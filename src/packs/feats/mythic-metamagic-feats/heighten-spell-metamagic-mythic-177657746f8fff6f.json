  "system": {
    "description": {
      "value": "<p>Your metamagic spells are always more potent.</p>\n<p><strong>Prerequisites:</strong> Heighten Spell<sup>CRB</sup>, 2nd mythic tier.</p>\n<p><strong>Benefit:</strong> When you apply metamagic feats to a spell, the effective level of the spell is increased to be equal to the level of the spell slot used to prepare or cast it. All effects dependent on spell level (such as saving throw DCs and ability to penetrate a lesser globe of invulnerability) are calculated according to the heightened level.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-metamagic-feats#toc20\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
