  "system": {
    "description": {
      "value": "<p><strong>Benefit:</strong> Whenever you roll a die of the listed shape and add the corresponding bonus type to the roll, you may spend an immediate action to reroll the die after seeing the result. If you do, the corresponding bonus type does not apply to the reroll.<br>\n<strong>Faceted Solid Die:</strong> Sacred or Profane bonus<br>\n<strong>Spinner Die:</strong> Luck bonus<br>\n<strong>Coin Die:</strong> Competence Bonus<br>\n<strong>Bullet/Barrel Die:</strong> Morale Bonus<br>\n<strong>Digital Die:</strong> Insight Bonus</p>\n<p><a href=\"http://spheresofpower.wikidot.com/playpiece-feats#toc2\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
