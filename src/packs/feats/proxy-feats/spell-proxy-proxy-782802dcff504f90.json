  "system": {
    "description": {
      "value": "<p><strong>Prerequisites:</strong> Enhancement sphere, Circle Casting.</p>\n<p><strong>Benefit:</strong> You gain access to an additional enhancement, which you may use normally:</p>\n<p>Create Proxy: You may enhance creatures, allowing them to act as aiding casters as if they themselves possessed the Circle Casting feat. They do not need to have any magic talents or a spell pool to do so.</p>\n<p><strong>Special:</strong> You may incorporate Create Proxy into a spell as if it were an Enhancement talent. You may not take Spell Proxy if you have the Personal Magics drawback.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/proxy-feats#toc6\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
