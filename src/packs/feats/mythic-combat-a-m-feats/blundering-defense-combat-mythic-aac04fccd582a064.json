  "system": {
    "description": {
      "value": "<p>Your frantically funny defensive measures distract enemies and aid allies across the battlefield.</p>\n<p><strong>Prerequisite:</strong> Blundering Defense<sup>ARG</sup></p>\n<p><strong>Benefit:</strong> Whenever you fight defensively or use the total defense action, allies gain a luck bonus to their AC equal to one-half the dodge bonus to AC you gain from the action you are taking. This affects all allies within 5 feet plus 5 feet for every 2 mythic tiers you possess.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-combat-a-m-feats#toc22\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
