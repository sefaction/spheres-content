  "system": {
    "description": {
      "value": "<p>Your throw prevents your enemy from adequately opposing your grapple.</p>\n<p><strong>Prerequisite:</strong> Binding Throw<sup>UC</sup></p>\n<p><strong>Benefit:</strong> When using Binding Throw, your grapple combat maneuver is a free action that you may use once per round. Additionally, although your target is grappled you do not gain the grappled condition until the end of your next turn (if you choose to maintain the grapple).</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-combat-a-m-feats#toc13\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
