  "system": {
    "description": {
      "value": "<p>Your devastating strike causes great harm to all nearby enemies.</p>\n<p><strong>Prerequisites:</strong> Devastating Strike<sup>UC</sup></p>\n<p><strong>Benefit:</strong> When you hit an opponent with Vital Strike, Improved Vital Strike, or Greater Vital Strike all enemies adjacent to your target suffer damage equal to the bonus damage provided by Devastating Strike. A successful Fortitude save (DC 10 + 1/2 your level + your Strength modifier) negates this extra damage. Non-mythic foes may not save against this damage.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-combat-a-m-feats#toc80\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
