  "system": {
    "description": {
      "value": "<p>Your martial abilities are laden with restorative akasha.</p>\n<p><strong>Prerequisites:</strong> 1 or more Radiant Dawn stances, Diplomacy 3 ranks.</p>\n<p><strong>Benefit:</strong> Whenever you initiate a maneuver, you or an ally within close range (25 feet + 5 feet/2 character levels) is healed for a number of hit points equal to your character level, plus the amount of essence invested in that maneuver. This effect can only trigger once per round.</p>\n<p>You gain 1 point of essence.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/rajah#toc48\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
