  "system": {
    "description": {
      "value": "<p>Your broken aspect may form a hostile bond with another creature.</p>\n<p><strong>Prerequisites:</strong> source-group bond species feature.</p>\n<p><strong>Benefit:</strong> Select one bond you are currently able to form, you may form a hostile version of it with a creature in Close range. They may make a Will save against a DC of 10 + 1/2 your character level + your Charisma modifier. If they fail instead of gaining your benefit your bond is inflicted as a penalty upon them, removing knowledge of feats, languages, or penalizing AC for 1 minute per character level.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mirrorkin#toc26\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
