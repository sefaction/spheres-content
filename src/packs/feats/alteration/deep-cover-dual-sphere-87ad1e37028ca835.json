  "system": {
    "description": {
      "value": "<p><strong>Prerequisites:</strong> Alteration sphere, Illusion sphere.</p>\n<p><strong>Benefit:</strong> In place of an Alteration trait you may apply the effects of your illusionary disguise to your form. This use of illusionary disguise no longer allows for a Will save to negate upon interaction, and lasts as long as the shapeshift does, requiring no additional spell points or concentration to maintain. This stacks with the Disguise bonus of the shapeshift and allows the shapeshift to attempt to assume the form of specific individuals.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/alteration#toc81\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
