  "system": {
    "description": {
      "value": "<p>Your chronomantic power extends to blurring the moment between life and death.</p>\n<p><strong>Prerequisites:</strong> Death sphere, Time sphere.</p>\n<p><strong>Benefit:</strong> You may use your Slow and Haste abilities as ghost strikes. Additionally, when you reanimate a body or bodies, you may augment them with your Haste ability as a free action. If the undead creatures are maintained through concentration (such as through the Sustained Reanimation talent), you may concentrate on Haste and the reanimation as part of the same action.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/death#toc108\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
