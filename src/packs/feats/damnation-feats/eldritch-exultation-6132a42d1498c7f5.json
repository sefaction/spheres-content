  "system": {
    "description": {
      "value": "<p><sup><strong>Source:</strong> Baron's Hallowed Archive</sup></p>\n<p><strong>Prerequisites:</strong> ability to cast arcane or psychic spells</p>\n<p><strong>Benefits:</strong> For the purpose of meeting the prerequisites for prestige classes, your arcane or psychic spells count as divine spells. Whenever you would advance divine spellcasting from a level in a prestige class, you may instead choose to advance your arcane or psychic spellcasting from a class by 1 level. You cannot choose this option if the same class level also advances arcane or psychic spellcasting (such as in the case of a mystic theurge).</p>\n<p><strong>Special:</strong> At GM discretion, this feat may count as a Damnation feat.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/damnation-feats#toc1\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
