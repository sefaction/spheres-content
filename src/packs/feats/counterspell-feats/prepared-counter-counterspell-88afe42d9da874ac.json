  "system": {
    "description": {
      "value": "<p><strong>Prerequisites:</strong> Counterspell, casting class feature, magic skill bonus +5.</p>\n<p><strong>Benefits:</strong> When you ready an action to use Counterspell, you may choose to limit your counterspell against a single sphere. You may only utilize your counterspell against sphere effects created with that sphere, or that utilize a dual-sphere feat related to that sphere. If you choose to limit your counterspell, you can choose to either reduce the spell point cost of your counterspell by 1 (minimum 0), or to roll twice and take the higher result on dispel attempts.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/counterspell-feats#toc18\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
