  "system": {
    "description": {
      "value": "<p><sup><strong>Source:</strong> Baron’s Glorious Arena</sup></p>\n<p><strong>Prerequisites:</strong> tension pool, Communication Sphere, Posse Commander; War sphere, Squadron Commander; or Warleader sphere, Troop Commander.</p>\n<p><strong>Benefits:</strong> As an immediate action, you may allow an ally in your squadron to use your tension pool and any abilities which involve spending tension as if they also had them until the end of the current turn. The tension cost of any ability used in this way increases by 1. A character cannot use both another squadron member’s tension and their own during the same turn.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/squadron-feats#toc3\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
