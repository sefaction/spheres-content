  "system": {
    "description": {
      "value": "<p>You’ve developed greater control over your tentacles, allowing you to move your center of gravity around to overturn opponents.</p>\n<p><strong>Prerequisites:</strong> Two or more tentacles, base attack bonus +2 or monk 1, Improved Unarmed Strike.</p>\n<p><strong>Benefit:</strong> You gain a +2 racial bonus to CMD to resist grapple checks and gain a +1 racial bonus to CMB when making a grapple or trip check. You may use your tentacles to make unarmed strikes.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/skybourne-feats#toc53\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
