  "system": {
    "description": {
      "value": "<p>Your selective study of spellblights allows you to unleash a host of horrors on your targets.</p>\n<p><strong>Prerequisite:</strong> Blighted Critical Mastery<sup>UM</sup></p>\n<p><strong>Benefit:</strong> Whenever you apply a spellblight by way of the Blighted Critical or Greater Blighted Critical feat, you may choose the spellblight you apply or you may choose to inflict two randomly determined spellblights of the appropriate type.</p>\n<p><strong>Wiki Note:</strong> This is not actually a critical feat and does not count as such for any purpose. It has been included here since it's related to the Blighted Critical feats.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-critical-feats#toc3\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
