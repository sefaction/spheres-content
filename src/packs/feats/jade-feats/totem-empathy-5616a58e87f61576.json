  "system": {
    "description": {
      "value": "<p>You are adept at changing the mood of creatures related to your totem.</p>\n<p><strong>Prerequisites:</strong> Lesser totem barbarian rage power, Cha 13.</p>\n<p><strong>Benefit:</strong> This feat works just like the druid’s wild empathy, except that it only works with creatures related to your totem (all non-lying insects for the centipede totem, all pachyderms for the elephant totem, all equines for the horse totem, all non-communal insects for the mantis totem, all primates for the monkey totem, and all felines for the tiger totem). To use totem empathy, you must roll 1d20 plus your barbarian level plus your Cha modifier.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/jade-feats#toc86\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
