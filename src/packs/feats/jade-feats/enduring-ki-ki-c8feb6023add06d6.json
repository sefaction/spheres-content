  "system": {
    "description": {
      "value": "<p>Your skilled use of ki makes the effects of expending your ki focus last longer.</p>\n<p><strong>Prerequisites:</strong> Con 15, Wis 13, any two ki or chakra feats.</p>\n<p><strong>Benefit:</strong> When expending your ki focus, the chakra beneit lasts for an additional round. You can do this a number of times per day equal to your Wisdom bonus.</p>\n<p>You gain one point of ki.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/jade-feats#toc96\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
