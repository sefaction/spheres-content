  "system": {
    "description": {
      "value": "<p>You can use ki to resist effects that would adversely affect your health.</p>\n<p><strong>Prerequisites:</strong> Con 13, Wis 13, Great Fortitude.</p>\n<p><strong>Benefit:</strong> While maintaining your ki focus, you gain an insight bonus on Fortitude saves equal to the number of ki points invested in this chakra.</p>\n<p>Expending your ki focus grants you an insight bonus on Fortitude saves equal to twice the number of ki points expended. This lasts for a number of rounds equal to your Constitution bonus (minimum 1).</p>\n<p>You gain one point of ki.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/jade-feats#toc19\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
