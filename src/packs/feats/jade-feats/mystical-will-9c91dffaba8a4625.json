  "system": {
    "description": {
      "value": "<p>You learn to tap into your magical nature with a burst of mental resilience that can overcome external influences.</p>\n<p><strong>Prerequisites:</strong> 1 or more levels in a spellcasting class, Improved Iron Will, Iron Will</p>\n<p><strong>Benefit:</strong> A number of times per day equal to the highest level spell the character is inherently capable of casting, he may substitute his Spellcasting ability modiier as his modifier for Will saving throws.</p>\n<p><strong>Normal:</strong> Will saving throws must be made with a character’s Wisdom modifier.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/jade-feats#toc78\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
