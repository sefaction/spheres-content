  "system": {
    "description": {
      "value": "<p>You learn how to briely harness your magical aptitude to overcome harm to your body.</p>\n<p><strong>Prerequisites:</strong> 1 or more levels in a spellcasting class, Improved Great Fortitude, Great Fortitude</p>\n<p><strong>Benefit:</strong> A number of times per day equal to the highest level spell the character is inherently capable of casting, he may substitute his Spellcasting ability modiier as his modiier for Fortitude saving throws.</p>\n<p><strong>Normal:</strong> Fortitude saving throws must be made with a character’s Constitution modifier.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/jade-feats#toc76\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
