  "system": {
    "description": {
      "value": "<p>The mandragoran’s pollen spores contain a hallucinogenic compound.</p>\n<p><strong>Prerequisites:</strong> Con 13, Mandragoran only.</p>\n<p><strong>Benefit:</strong> A number of times per day equal to the Constitution bonus, all creatures within range of the mandragoran’s spore scent ability must make a Will save (DC 10 + half your mandragoran’s character level + your Charisma modiier), or suffer a -2 penalty to all dice rolls as they suffer from debilitating hallucinations. This effect lasts a number of rounds equal to half the mandragoran’s character level.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/jade-feats#toc67\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
