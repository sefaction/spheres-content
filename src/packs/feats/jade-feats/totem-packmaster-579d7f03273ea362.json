  "system": {
    "description": {
      "value": "<p>Creatures related to your totem feel drawn to your leadership.</p>\n<p><strong>Prerequisites:</strong> Totem Empathy, totem pact class ability, barbarian level 7th.</p>\n<p><strong>Benefit:</strong> This feat functions as the Leadership feat, except for the following: you substitute your totem pact animal companion for your cohort (its HD are affected by your level, and not by this feat), your number of followers by level is instead your number of followers by hit dice, and your followers can only be creatures related to your totem (see Totem Empathy feat).</p>\n<p><a href=\"http://spheresofpower.wikidot.com/jade-feats#toc87\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
