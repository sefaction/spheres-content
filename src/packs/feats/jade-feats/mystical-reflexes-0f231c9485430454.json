  "system": {
    "description": {
      "value": "<p>You learn to use your magical talent to react to dangerous situations with a momentary burst of supernatural speed.</p>\n<p><strong>Prerequisites:</strong> 1 or more levels in a spellcasting class, Improved Lightning Relexes, Lightning Reflexes</p>\n<p><strong>Benefit:</strong> A number of times per day equal to the highest level spell the character is inherently capable of casting he may substitute his Spellcasting ability modiier as his modiier for Reflex saving throws.</p>\n<p><strong>Normal:</strong> Relex saving throws must be made with a character’s Dexterity modifier.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/jade-feats#toc77\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
