  "system": {
    "description": {
      "value": "<p><sup><strong>Source:</strong> Expanded Spheres: Baron's Lost Apocrypha</sup></p>\n<p><strong>Prerequisites:</strong> Destruction sphere (Admixture), Creation sphere.</p>\n<p><strong>Benefit:</strong> When using Admixture, you may spend an additional spell point to have a single creature that takes damage be targeted by an alter effect that you possess. If you possess the Divided Creation talent with the Mass Alter option, you may apply alter to any targets damaged, up to your maximum targets from Divided Creation. Alternatively, you may spend an additional spell point to create an object in the target’s square or another affected square, or create multiple objects if you possess the Divided Creation talent with the Multiple Creations option.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/admixture-feats#toc10\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
