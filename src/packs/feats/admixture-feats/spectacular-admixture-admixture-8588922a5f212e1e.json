  "system": {
    "description": {
      "value": "<p><sup><strong>Source:</strong> Expanded Spheres: Baron's Lost Apocrypha</sup></p>\n<p><strong>Prerequisites:</strong> Destruction sphere (Admixture), Illusion sphere.</p>\n<p><strong>Benefit:</strong> When using Admixture, you may spend an additional spell point to affect one target damaged by the destructive blast with a glamer effect in place of a second blast type. If you possess Complex Illusion, you may apply the glamer to any targets damaged, up to your maximum targets from Complex Illusion. Alternatively, you may spend an additional spell point to center a figment effect on the target’s square or another affected square.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/admixture-feats#toc21\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
