  "system": {
    "description": {
      "value": "<p>Your mythic power gives you additional rounds of bardic performance each day.</p>\n<p><strong>Prerequisites:</strong> Extra Performance<sup>CRB</sup></p>\n<p><strong>Benefit:</strong> You can use your bardic performance for 8 additional rounds per day. Additionally, as a swift action you can expend one use of mythic power to regain 2 rounds of bardic performance (not to exceed your maximum rounds of bardic performance for the day).</p>\n<p><strong>Special:</strong> Unlike Extra Performance, you cannot take Mythic Extra Performance more than once.</p>\n<p><a href=\"http://spheresofpower.wikidot.com/mythic-extra-feats#toc14\">Source: Spheres of Power Wiki</a></p>",
      "instructions": ""
    },
